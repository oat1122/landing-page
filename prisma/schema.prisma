// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Model สำหรับ NextAuth + Custom User
model User {
  id            String    @id @default(uuid())
  username      String    @unique
  password      String    // Hash ด้วย bcryptjs
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("USER") // USER, ADMIN

  accounts Account[]
  sessions Session[]
  images   Image[]
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

// Models สำหรับ NextAuth Adapter
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtoken")
}

// Model สำหรับ Image Upload พร้อม SEO
model Image {
  id          String   @id @default(uuid())
  
  // File Information
  filename    String               // ชื่อไฟล์ original
  filepath    String   @unique     // path เก็บไฟล์
  url         String               // URL สำหรับ access รูป
  mimeType    String               // image/jpeg, image/png, image/webp
  size        Int                  // ขนาดไฟล์ (bytes)
  width       Int?                 // ความกว้าง (pixels)
  height      Int?                 // ความสูง (pixels)
  
  // SEO Fields
  alt         String               // Alt text สำหรับ accessibility & SEO
  title       String?              // Title attribute
  caption     String?  @db.Text    // คำอธิบายรูปภาพ
  description String?  @db.Text    // รายละเอียดเพิ่มเติม
  
  // Organization
  category    String?              // หมวดหมู่ เช่น "product", "blog", "banner"
  tags        String?  @db.Text    // Tags คั่นด้วย comma
  
  // Usage Tracking
  usedIn      String?  @db.Text    // Where this image is used (JSON)
  
  // Metadata
  uploadedBy  String?              // User ID ที่อัพโหลด
  user        User?    @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  
  // Products using this image
  products    Product[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([category])
  @@index([uploadedBy])
  @@map("image")
}

// =========================================
// Product Management Models
// =========================================

// Product Category (1 product = 1 category)
model ProductCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  sortOrder   Int       @default(0)
  
  products    Product[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@map("product_category")
}

// Product Tags (1 product = many tags)
model ProductTag {
  id        String           @id @default(uuid())
  name      String           @unique
  slug      String           @unique
  
  products  ProductToTag[]
  
  createdAt DateTime         @default(now())
  
  @@map("product_tag")
}

// Product
model Product {
  id           String         @id @default(uuid())
  
  // Basic Info
  name         String
  slug         String         @unique
  sku          String?        @unique
  description  String?        @db.Text
  
  // Pricing
  price        Decimal?       @db.Decimal(10, 2)
  comparePrice Decimal?       @db.Decimal(10, 2)
  
  // Type: real or sample
  type         String         @default("real") // "real" | "sample"
  
  // Image from existing Image system
  mainImageId  String?
  mainImage    Image?         @relation(fields: [mainImageId], references: [id], onDelete: SetNull)
  
  // Category (1 product = 1 category)
  categoryId   String?
  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  // Tags (many-to-many)
  tags         ProductToTag[]
  
  // SEO fields
  metaTitle       String?
  metaDescription String?      @db.Text
  
  // Status
  status       String         @default("draft") // "draft" | "active" | "inactive"
  featured     Boolean        @default(false)
  
  // Metadata
  createdBy    String?
  user         User?          @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  
  @@index([categoryId])
  @@index([status])
  @@index([type])
  @@index([createdBy])
  @@map("product")
}

// Junction table for Product-Tag many-to-many
model ProductToTag {
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  tag        ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId      String
  
  @@id([productId, tagId])
  @@map("product_to_tag")
}

